# ============ SERVIDOR ============
# Porta do servidor (padrão 3000)
PORT=3000

# IP do servidor (0.0.0.0 = acessível na rede)
HOST=0.0.0.0

# ============ EMAIL (código de verificação) ============
# Modo console: mostra o código no terminal do servidor (útil para testar)
MAIL_MODE=console

# OPÇÃO 1 (OBRIGATÓRIA NA RAILWAY): Resend via API HTTPS.
# A Railway bloqueia SMTP (portas 25/465/587) nos planos Free/Hobby!
# 1) Crie conta grátis em https://resend.com (pode entrar com Google)
# 2) API Keys -> Create API Key -> copie (começa com "re_")
# 3) Sem domínio próprio, a Resend só envia para o email da sua conta Resend
#    (o que basta: você entra no site com o seu próprio email)
#RESEND_API_KEY=re_cole-aqui-sua-chave
#RESEND_FROM="Nexus Control <onboarding@resend.dev>"

# OPÇÃO 2: SMTP direto (funciona localmente; NÃO funciona na Railway Free/Hobby)
# Exemplo com Gmail:
# 1) Ative a "verificação em 2 etapas" no Google
# 2) Crie uma "senha de app" em https://myaccount.google.com/apppasswords
# 3) Descomente e preencha:
#MAIL_MODE=smtp
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_SECURE=false
#MAIL_USER=seuemail@gmail.com
#MAIL_PASS=sua-senha-de-app
#MAIL_FROM="Nexus Control <seuemail@gmail.com>"

# ============ JARVIS (assistente de IA) ============
# SEM chave: o Jarvis reconhece comandos prontos em português
#   (bateria, status, localização, tela, abrir site/app, lanterna, câmera, arquivos…)
# COM chave: vira um assistente de conversa livre que controla os dispositivos.
#
# 🔑 GRÁTIS (recomendado): crie uma chave no Groq em https://console.groq.com
#   (Login com Google/GitHub → API Keys → Create API Key)
#   Exemplo de configuração com Groq:
#OPENAI_API_KEY=gsk_cole-aqui-sua-chave
#OPENAI_BASE_URL=https://api.groq.com/openai/v1
#OPENAI_MODEL=llama-3.3-70b-versatile
#
# Ou OpenAI: https://platform.openai.com
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

# ============ AGENTE AUTOMÁTICO (roda no notebook) ============
# Email que você usa para entrar no site. O agente será conectado à sua conta
# automaticamente ao rodar ./start.sh (token gerado em data/agent.token).
NEXUS_AGENT_EMAIL=

# ============ AGENTE (roda no notebook) ============
# URL do servidor (ex: http://SEU-IP:3000 ou https://seuapp.railway.app)
NEXUS_URL=http://localhost:3000
# Token do agente: pegue no site após o login, aba "Agente"
NEXUS_TOKEN=
# Nome do notebook quando aparece nos dispositivos
NEXUS_DEVICE_NAME=Notebook (agente)
# Pasta onde arquivos recebidos serão salvos
#NEXUS_DOWNLOAD_DIR=/home/USUARIO/Downloads/Nexus